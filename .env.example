AO_CLOUD_ENV=development
AO_CLOUD_RELEASE=dev
AO_CLOUD_HTTP_ADDRESS=127.0.0.1:8080
AO_CLOUD_DATABASE_URL=postgres://localhost/ao_cloud?sslmode=disable
# Optional elevated migration credential; defaults to AO_CLOUD_DATABASE_URL.
AO_CLOUD_MIGRATION_DATABASE_URL=
# Defaults to true for development/test and false for staging/production.
AO_CLOUD_MIGRATE_ON_STARTUP=
# Bounds migration lock waits and DDL execution.
AO_CLOUD_MIGRATION_TIMEOUT=15m
# Optional role that receives runtime grants after each hosted migration.
AO_CLOUD_RUNTIME_DATABASE_USER=

# Production authentication. Set all three together. The WorkOS API base URL
# is expanded to the client-specific AuthKit token issuer at startup.
AO_CLOUD_WORKOS_ISSUER=
AO_CLOUD_WORKOS_CLIENT_ID=
AO_CLOUD_WORKOS_API_KEY=
# Optional override. Defaults to the WorkOS or custom AuthKit-domain JWKS URL.
AO_CLOUD_WORKOS_JWKS_URL=

# Development only. Enable explicitly when running without WorkOS.
AO_CLOUD_LOCAL_AUTH=false
AO_CLOUD_LOCAL_SESSION_TTL=24h

# Durable workspace intent only; provisioning is implemented separately.
AO_CLOUD_SANDBOX_PROVIDER=ecs

# Optional GitHub App integration. Set every value together. The private key is
# the PEM downloaded for the App; STATE_KEY is 32 random bytes encoded as base64.
AO_CLOUD_GITHUB_APP_ID=
AO_CLOUD_GITHUB_APP_SLUG=
AO_CLOUD_GITHUB_CLIENT_ID=
AO_CLOUD_GITHUB_CLIENT_SECRET=
AO_CLOUD_GITHUB_PRIVATE_KEY=
AO_CLOUD_GITHUB_WEBHOOK_SECRET=
AO_CLOUD_GITHUB_STATE_KEY=
AO_CLOUD_GITHUB_INSTALL_TTL=10m
AO_CLOUD_GITHUB_WEBHOOK_MAX_BYTES=2097152
AO_CLOUD_PUBLIC_URL=

# Optional overrides used only by `npm run cloud:staging`. The command defaults
# to staging-api.aoagents.dev and the checked-in non-secret staging client ID.
AO_CLOUD_STAGING_URL=
VITE_WORKOS_CLIENT_ID=
