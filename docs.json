{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Agent Orchestrator",
  "theme": "luma",
  "logo": {
    "light": "/docs/logo/ao-logo.svg",
    "dark": "/docs/logo/ao-logo.svg",
    "href": "https://aoagents.dev"
  },
  "favicon": "/docs/logo/ao-logo.svg",
  "colors": {
    "primary": "#d25611",
    "light": "#e8804a",
    "dark": "#9e400a"
  },
  "fonts": {
    "heading": { "family": "Geist Sans", "weight": 700 },
    "body": { "family": "Geist Sans", "weight": 400 }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "search": {
    "prompt": "Search Agent Orchestrator docs..."
  },

  "footerSocials": {
    "github": "https://github.com/Untrivial-ai/agent-orchestrator",
    "x": "https://x.com/aoagents"
  },
  "navigation": {
    "anchors": [
      {
        "anchor": "GitHub",
        "icon": "github",
        "href": "https://github.com/Untrivial-ai/agent-orchestrator"
      },
      {
        "anchor": "Discord",
        "icon": "discord",
        "href": "https://discord.com/invite/UZv7JjxbwG"
      },
      {
        "anchor": "Changelog",
        "icon": "list",
        "href": "/docs/changelog/overview"
      }
    ],
    "tabs": [
      {
        "tab": "Get started",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "docs/introduction",
              "docs/installation",
              "docs/quickstart"
            ]
          }
        ]
      },
