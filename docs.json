    "markdown": {
      "image": {
        "modal": true
      }
    },
    "mdx": {
      "components": {
        "Callout": {
          "primary": {
            "icon": "info",
            "color": "primary"
          },
          "secondary": {
            "icon": "lightbulb",
            "color": "secondary"
          },
          "warning": {
            "icon": "alert-triangle",
            "color": "warning"
          },
          "error": {
            "icon": "x-circle",
            "color": "danger"
          },
          "success": {
            "icon": "check-circle",
            "color": "success"
          }
        }
      }
    },
    "styles": [
      {
        "path": "docs/_styles/custom.css"
      }
    ]
  }
